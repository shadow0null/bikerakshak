<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BikeRakshak"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motihari, East Champaran"
                    android:textSize="13sp"
                    android:textColor="@color/text_grey"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_offer_banner"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIMITED TIME OFFER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10% OFF ON YOUR FIRST ORDER"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book your first service today and experience premium care."
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnOfferBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Now"
                android:backgroundTint="@color/white"
                android:textColor="@color/rescue_orange"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45–60 Min"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arrival Time"
                    android:textSize="11sp"
                    android:textColor="@color/text_grey" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transparent Price"
                    android:textSize="11sp"
                    android:textColor="@color/text_grey" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24×7"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Help"
                    android:textSize="11sp"
                    android:textColor="@color/text_grey" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Our Services"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:layout_marginTop="20dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/cardService2Wheeler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="2-Wheeler Service"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/cardPuncture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="Puncture Repair"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/cardJumpStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="Jump Start"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/cardBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="Battery"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />
        </GridLayout>

        <Button
            android:id="@+id/btnBookService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book a Service"
            android:backgroundTint="@color/rescue_orange"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No active orders yet"
            android:textSize="14sp"
            android:textColor="@color/text_grey"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
